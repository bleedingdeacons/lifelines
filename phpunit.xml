<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
    bootstrap="tests/bootstrap.php"
    colors="true"
    displayDetailsOnTestsThatTriggerWarnings="true"
    failOnRisky="true"
    failOnWarning="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <!--
                The admin settings screen: WordPress menu/enqueue hooks, the
                HTML form render, and file-upload handling (move_uploaded_file /
                wp_upload_dir) exercised through WordPress at runtime rather
                than in unit tests. Excluded from the coverage denominator, as
                the other suite plugins exclude their src/Admin layers.
            -->
            <file>src/Lookup/SettingsPage.php</file>
        </exclude>
    </source>
</phpunit>
